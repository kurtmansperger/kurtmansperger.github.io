---
// Printable résumé. Renders from the same data as the homepage and is the
// source for public/pdf/Kurt Mansperger Resume.pdf (see npm run resume:pdf).
import '@fontsource-variable/inter';
import {
  profile,
  summary,
  experience,
  volunteer,
  education,
  skills,
  personal,
} from '../data/resume';

const title = `${profile.name} — Résumé`;
const description = `Résumé of ${profile.name}, ${profile.title} at ${profile.org}.`;
const canonical = new URL('/resume', profile.siteUrl).href;
const linkedinHandle = profile.linkedin.replace(/^https?:\/\/(www\.)?/, '');
const githubHandle = profile.github.replace(/^https?:\/\/(www\.)?/, '');
const siteHandle = profile.siteUrl.replace(/^https?:\/\//, '');

const coreSkills = skills.filter((g) => g.name !== 'Certifications');
const certifications = skills.find((g) => g.name === 'Certifications')?.items ?? [];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <nav class="screen-only toolbar" aria-label="Résumé actions">
      <a href="/">← kurtmansperger.com</a>
      <div>
        <a href={profile.resumePdf} target="_blank" rel="noopener">Download PDF</a>
        <button type="button" onclick="window.print()">Print</button>
      </div>
    </nav>

    <main class="sheet">
      <header class="head">
        <div>
          <h1>{profile.name}</h1>
          <p class="headline">{profile.title} · {profile.org}</p>
        </div>
        <address>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span>{profile.phone}</span>
          <a href={profile.linkedin}>{linkedinHandle}</a>
          <a href={profile.github}>{githubHandle}</a>
          <a href={profile.siteUrl}>{siteHandle}</a>
          <span>{profile.location}</span>
        </address>
      </header>

      <section>
        <h2>Summary</h2>
        <p class="summary">{summary}</p>
      </section>

      <section>
        <h2>Core Skills</h2>
        <dl class="skills">
          {coreSkills.map((g) => (
            <div>
              <dt>{g.name}</dt>
              <dd>{g.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section>
        <h2>Experience</h2>
        {experience.map((role) => (
          <article class="role">
            <div class="role-head">
              <h3>
                {role.title} <span class="org">| {role.org}</span>
              </h3>
              <span class="dates">{role.dates}</span>
            </div>
            {role.note && <p class="note">{role.note}</p>}
            <ul>
              {role.body.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section class="two-col">
        <div>
          <h2>Education</h2>
          {education.map((e) => (
            <p class="edu">
              <strong>{e.degree}</strong>, {e.org}
              {e.body && <span class="muted"> · {e.body}</span>}
            </p>
          ))}
        </div>
        <div>
          <h2>Certifications</h2>
          <p class="edu">{certifications.join(' · ')}</p>
        </div>
      </section>

      <section class="two-col">
        <div>
          <h2>Board &amp; Volunteer</h2>
          {volunteer.map((v) => (
            <p class="edu">
              <strong>{v.title}</strong>, {v.org} <span class="muted">({v.dates})</span>
            </p>
          ))}
        </div>
        <div>
          <h2>Outside Work</h2>
          <p class="edu">{personal.join(' · ')}</p>
        </div>
      </section>
    </main>

    <style is:global>
      :root {
        --ink: #14161b;
        --muted: #5b6070;
        --rule: #d9dbe1;
        --accent: #1f4fbf;
        --page-bg: #eef0f4;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: 'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 10.25pt;
        line-height: 1.38;
        color: var(--ink);
        background: var(--page-bg);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        font-feature-settings: 'cv05', 'ss01';
      }
      a { color: inherit; text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3, p, ul, dl { margin: 0; }

      .toolbar {
        max-width: 8.5in;
        margin: 0 auto;
        padding: .75rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .9rem;
        color: var(--muted);
      }
      .toolbar a, .toolbar button {
        color: var(--accent);
        font: inherit;
        background: none;
        border: 0;
        cursor: pointer;
        padding: 0;
        margin-left: 1rem;
      }
      .toolbar > a:first-child { margin-left: 0; }

      .sheet {
        background: #fff;
        max-width: 8.5in;
        margin: 0 auto 2rem;
        padding: .6in .65in;
        box-shadow: 0 2px 20px rgba(20, 22, 27, .08);
      }

      .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        padding-bottom: .55rem;
        border-bottom: 2px solid var(--ink);
        margin-bottom: .7rem;
      }
      h1 {
        font-size: 22pt;
        font-weight: 750;
        letter-spacing: -.02em;
        line-height: 1.1;
      }
      .headline {
        margin-top: .2rem;
        font-size: 11pt;
        font-weight: 550;
        color: var(--accent);
      }
      address {
        font-style: normal;
        display: grid;
        grid-template-columns: auto auto;
        gap: .1rem 1rem;
        font-size: 8.75pt;
        color: var(--muted);
        text-align: right;
        white-space: nowrap;
      }
      address a { color: var(--ink); }

      section { margin-top: .75rem; }
      h2 {
        font-size: 8.5pt;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--accent);
        border-bottom: 1px solid var(--rule);
        padding-bottom: .2rem;
        margin-bottom: .45rem;
      }
      .summary { text-align: justify; hyphens: auto; }

      .skills { display: grid; gap: .18rem; }
      .skills div { display: grid; grid-template-columns: 6.9rem 1fr; gap: .6rem; }
      .skills dt { font-weight: 650; color: var(--ink); }
      .skills dd { margin: 0; color: var(--ink); }

      .role { margin-bottom: .6rem; break-inside: avoid-page; }
      .role-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
      }
      h3 { font-size: 10.75pt; font-weight: 700; }
      h3 .org { font-weight: 550; color: var(--muted); }
      .dates {
        font-size: 9pt;
        color: var(--muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .note { font-size: 9pt; color: var(--muted); font-style: italic; margin: .05rem 0 .1rem; }
      .role ul { padding-left: 1.05rem; margin-top: .2rem; }
      .role li { margin: .12rem 0; padding-left: .1rem; }
      .role li::marker { color: var(--accent); }

      .two-col { display: grid; grid-template-columns: 1.35fr 1fr; gap: 1.25rem; }
      .edu { margin-bottom: .25rem; }
      .muted { color: var(--muted); }

      @media (max-width: 640px) {
        body { font-size: 15px; }
        .sheet { padding: 1.25rem 1rem; margin-bottom: 0; }
        .head { flex-direction: column; gap: .5rem; }
        address { text-align: left; grid-template-columns: 1fr; white-space: normal; }
        .role-head { flex-direction: column; gap: 0; }
        .skills div, .two-col { grid-template-columns: 1fr; }
        .summary { text-align: left; }
      }

      @page { size: Letter; margin: .5in .55in; }
      @media print {
        .screen-only { display: none !important; }
        html, body { background: #fff; }
        body { font-size: 9.6pt; line-height: 1.34; }
        .sheet { max-width: none; margin: 0; padding: 0; box-shadow: none; }
        section { margin-top: .5rem; }
        h2 { margin-bottom: .3rem; }
        .summary { text-align: left; }
        .role { margin-bottom: .45rem; }
        .role li { margin: .06rem 0; }
        .two-col { break-inside: avoid-page; }
        a[href^='http']::after, a[href^='mailto']::after { content: none; }
      }
    </style>
  </body>
</html>
